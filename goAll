#!/bin/bash
#
# goAll — copia export PSA e MIRO da Drive ed elabora solo i file appena copiati.
#
# Lo script risiede in rend-script-psa/; va lanciato da rend-script-psa/venv
# (es. cd rend-script-psa/venv && ../goAll). Dati e risultati in venv/Data/.
# Python viene eseguito dalla cartella script; config cercata anche in venv/.
#
# 1. Copia PSA (copia_drive-PSA.sh) → venv/Data/
# 2. Elabora nuovi DvPFilter-RHCC-All-Assignments-Full* con elabora_progetti.py
#    (rinomina rimuovendo il prefisso DvPFilter-)
# 3. Copia export email JBOSS-Barison (Parte_*.txt) → venv/Data/Email e JBOSS-Barison-Mail
# 4. estrai-mail.py → email.lst in TARGET_DIR
# 5. Copia MIRO *-Intesa-JBOSS.csv (copia_drive-Miro.sh) → venv/Data/
# 6. Elabora i file JKAN appena copiati con elabora_JKAN.py (rinomina con prefisso x-)
#
# Variabili opzionali:
#   TARGET_DIR       cartella dati (default: <script>/venv/Data)
#   CLIENTE          filtro cliente per elabora_progetti.py (default: Intesa)
#   DRIVE_DIR_PSA    cartella Drive export PSA (default: come copia_drive-PSA.sh)
#   DRIVE_DIR_MIRO   cartella Drive export MIRO (default: come copia_drive-Miro.sh)
#   DRIVE_GDRIVE_ROOT radice «Il mio Drive» (default: come sotto)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$SCRIPT_DIR/venv"
TARGET_DIR="${TARGET_DIR:-$VENV_DIR/Data}"
CLIENTE="${CLIENTE:-Intesa}"
PATTERN_PSA='DvPFilter-RHCC-All-Assignments-Full*'
PATTERN_JKAN='*-Intesa-JBOSS.csv'
# Radice Drive: «Il mio Drive» — spazi gestiti con variabile quotata (in shell: Il\ mio\ Drive a mano)
GDRIVE_IL_MIO_DRIVE="$HOME/Library/CloudStorage/GoogleDrive-dpini@redhat.com/Il mio Drive"
DRIVE_GDRIVE_ROOT="${DRIVE_GDRIVE_ROOT:-$GDRIVE_IL_MIO_DRIVE}"
DRIVE_DIR_PSA="${DRIVE_DIR_PSA:-$DRIVE_GDRIVE_ROOT/Customers/DvPFilter-RHCC-All-Assignments-Full}"
DRIVE_DIR_MIRO="${DRIVE_DIR_MIRO:-$DRIVE_GDRIVE_ROOT/Customers/Miro}"
DRIVE_DIR_EMAIL_BARISON="${DRIVE_DIR_EMAIL_BARISON:-$DRIVE_DIR_MIRO/JBOSS-Barison-Mail}"
PATTERN_EMAIL='Email_Esportate___JBOSS-Barison_Parte_*.txt'

mkdir -p "$VENV_DIR" "$TARGET_DIR"
TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"
EMAIL_LOCAL_DIR="$TARGET_DIR/Email"

if [ -x "$VENV_DIR/bin/python3" ]; then
    PYTHON="$VENV_DIR/bin/python3"
else
    PYTHON=python3
fi

copia_risultato_su_drive() {
    local src="$1"
    local drive_dir="$2"
    local label="$3"

    if [ ! -f "$src" ]; then
        echo "Attenzione: risultato assente, copia Drive saltata ($label): $src"
        return 1
    fi
    if [ ! -d "$drive_dir" ]; then
        echo "Attenzione: cartella Drive non disponibile ($label), copia saltata: $drive_dir"
        return 1
    fi

    rsync -a "$src" "$drive_dir/"
    echo "Copiato su Drive ($label): $drive_dir/$(basename "$src")"
}

# --- PSA: DvPFilter- → RHCC- (elaborato) ---

nome_elaborato_psa() {
    local name="$1"
    echo "$name" | sed 's/^DvPFilter-//'
}

file_gia_elaborato_psa() {
    local dvpfilter_name="$1"
    local renamed
    renamed=$(nome_elaborato_psa "$dvpfilter_name")
    [ -e "$TARGET_DIR/$renamed" ]
}

BEFORE_LIST_PSA=""
for f in "$TARGET_DIR"/$PATTERN_PSA; do
    [ -e "$f" ] || continue
    BEFORE_LIST_PSA+="$(basename "$f")"$'\n'
done

file_gia_presente_psa() {
    local name="$1"
    [ -z "$BEFORE_LIST_PSA" ] && return 1
    printf '%s\n' "$BEFORE_LIST_PSA" | grep -Fxq "$name"
}

# --- JKAN: x- (elaborato) ---

nome_trattato_jkan() {
    local name="$1"
    echo "x-$name"
}

file_gia_trattato_jkan() {
    local name="$1"
    [ -e "$TARGET_DIR/$(nome_trattato_jkan "$name")" ]
}

BEFORE_LIST_JKAN=""
for f in "$TARGET_DIR"/$PATTERN_JKAN; do
    [ -e "$f" ] || continue
    base=$(basename "$f")
    [[ "$base" == x-* ]] && continue
    BEFORE_LIST_JKAN+="$base"$'\n'
done

file_gia_presente_jkan() {
    local name="$1"
    [ -z "$BEFORE_LIST_JKAN" ] && return 1
    printf '%s\n' "$BEFORE_LIST_JKAN" | grep -Fxq "$name"
}

# --- 1/4 Copia PSA ---

echo "=== 1/6 Copia PSA (copia_drive-PSA.sh) → $TARGET_DIR ==="
DRIVE_DIR="$DRIVE_DIR_PSA" LOCAL_DIR="$TARGET_DIR" "$SCRIPT_DIR/copia_drive-PSA.sh"

if [ ! -d "$TARGET_DIR" ]; then
    echo "Errore: la cartella '$TARGET_DIR' non esiste."
    exit 1
fi

# --- 2/4 Elaborazione PSA ---

echo ""
echo "=== 2/6 Elaborazione file PSA appena copiati ==="

processed_psa=0
skipped_psa=0

for FILEPATH in "$TARGET_DIR"/$PATTERN_PSA; do
    [ -e "$FILEPATH" ] || continue

    FILENAME=$(basename "$FILEPATH")

    if file_gia_presente_psa "$FILENAME"; then
        # DvPFilter già in Data/ prima della copia: di default non si rielabora.
        # Eccezione: se manca la versione RHCC (es. cancellata per forzare rigenerazione),
        # rielabora comunque.
        if file_gia_elaborato_psa "$FILENAME"; then
            continue
        fi
        echo "Rielaborazione: $FILENAME (versione RHCC assente in $TARGET_DIR)"
    fi

    if file_gia_elaborato_psa "$FILENAME"; then
        RENAMED=$(nome_elaborato_psa "$FILENAME")
        echo "Già elaborato (esiste $RENAMED), salto: $FILENAME"
        rm -f "$FILEPATH"
        continue
    fi

    DATA_FILE=$(echo "$FILENAME" | sed -n 's/.*Full-\([0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}\).*/\1/p')
    if [ -z "$DATA_FILE" ]; then
        echo "Salta file (formato data non valido): $FILENAME"
        skipped_psa=$((skipped_psa + 1))
        continue
    fi

    echo "--------------------------------------------------"
    echo "Elaborazione PSA (nuovo): $FILENAME"
    echo "Data estratta: $DATA_FILE"

    if (
        cd "$SCRIPT_DIR"
        "$PYTHON" elabora_progetti.py "$CLIENTE" "$FILEPATH" "$TARGET_DIR/${DATA_FILE}-Result-PSA.xlsx"
    ); then
        RESULT_PSA="$TARGET_DIR/${DATA_FILE}-Result-PSA.xlsx"
        echo "Output report: $RESULT_PSA"
        copia_risultato_su_drive "$RESULT_PSA" "$DRIVE_DIR_PSA" "PSA" || true
        NUOVO_NOME=$(nome_elaborato_psa "$FILENAME")
        echo "Rinomino il file in: $NUOVO_NOME"
        mv "$FILEPATH" "$TARGET_DIR/$NUOVO_NOME"
        processed_psa=$((processed_psa + 1))
    else
        echo "Errore durante l'elaborazione Python. Il file non è stato rinominato."
    fi
done

echo "--------------------------------------------------"
if [ "$processed_psa" -eq 0 ]; then
    echo "Nessun nuovo file PSA elaborato."
else
    echo "Elaborati $processed_psa nuovo/i file PSA."
fi
if [ "$skipped_psa" -gt 0 ]; then
    echo "Saltati $skipped_psa file PSA con nome non valido."
fi

# --- 3/6 Copia export email JBOSS-Barison ---

echo ""
echo "=== 3/6 Copia export email JBOSS-Barison → $EMAIL_LOCAL_DIR ==="
mkdir -p "$EMAIL_LOCAL_DIR"
copiati_email=0

if [ ! -d "$DRIVE_GDRIVE_ROOT" ]; then
    echo "Cartella Drive non disponibile, salto copia email: $DRIVE_GDRIVE_ROOT"
else
    shopt -s nullglob
    EMAIL_FILES=( "$DRIVE_GDRIVE_ROOT"/$PATTERN_EMAIL )
    if [ "${#EMAIL_FILES[@]}" -eq 0 ]; then
        echo "Nessun file $PATTERN_EMAIL in $DRIVE_GDRIVE_ROOT, salto copia email."
    else
        if [ ! -d "$DRIVE_DIR_EMAIL_BARISON" ]; then
            echo "Attenzione: cartella JBOSS-Barison-Mail assente, copia solo in locale:"
            echo "  $DRIVE_DIR_EMAIL_BARISON"
        fi
        for SRC_EMAIL in "${EMAIL_FILES[@]}"; do
            BASE_EMAIL=$(basename "$SRC_EMAIL")
            rsync -a "$SRC_EMAIL" "$EMAIL_LOCAL_DIR/"
            echo "Copiato in Data/Email: $BASE_EMAIL"
            if [ -d "$DRIVE_DIR_EMAIL_BARISON" ]; then
                rsync -a "$SRC_EMAIL" "$DRIVE_DIR_EMAIL_BARISON/"
                echo "Copiato in JBOSS-Barison-Mail: $BASE_EMAIL"
            fi
            copiati_email=$((copiati_email + 1))
        done
    fi
    shopt -u nullglob
fi

if [ "$copiati_email" -gt 0 ]; then
    echo "File email copiati: $copiati_email"
fi

# --- 4/6 estrai-mail.py ---

echo ""
echo "=== 4/6 Estrazione indice email (estrai-mail.py) ==="
if [ -d "$EMAIL_LOCAL_DIR" ] && [ -n "$(ls -A "$EMAIL_LOCAL_DIR" 2>/dev/null)" ]; then
    (
        cd "$SCRIPT_DIR"
        EMAIL_DIR="$EMAIL_LOCAL_DIR" EMAIL_LST="$TARGET_DIR/email.lst" \
            "$PYTHON" estrai-mail.py
    ) || echo "Attenzione: estrai-mail.py terminato con errore (si prosegue con JKAN)."
elif [ -d "$DRIVE_DIR_EMAIL_BARISON" ]; then
    (
        cd "$SCRIPT_DIR"
        EMAIL_DIR="$DRIVE_DIR_EMAIL_BARISON" EMAIL_LST="$TARGET_DIR/email.lst" \
            "$PYTHON" estrai-mail.py
    ) || echo "Attenzione: estrai-mail.py terminato con errore (si prosegue con JKAN)."
else
    echo "Nessuna cartella email disponibile, salto estrai-mail.py."
fi

# --- 5/6 Copia MIRO JKAN ---

echo ""
echo "=== 5/6 Copia MIRO (copia_drive-Miro.sh) → $TARGET_DIR ==="
DRIVE_DIR="$DRIVE_DIR_MIRO" LOCAL_DIR="$TARGET_DIR" "$SCRIPT_DIR/copia_drive-Miro.sh"

# --- 6/6 Elaborazione JKAN ---

echo ""
echo "=== 6/6 Elaborazione file JKAN appena copiati ==="

processed_jkan=0

for FILEPATH in "$TARGET_DIR"/$PATTERN_JKAN; do
    [ -e "$FILEPATH" ] || continue

    FILENAME=$(basename "$FILEPATH")
    [[ "$FILENAME" == x-* ]] && continue

    if file_gia_presente_jkan "$FILENAME"; then
        continue
    fi

    if file_gia_trattato_jkan "$FILENAME"; then
        TRATTATO=$(nome_trattato_jkan "$FILENAME")
        echo "Già elaborato (esiste $TRATTATO), salto: $FILENAME"
        rm -f "$FILEPATH"
        continue
    fi

    echo "--------------------------------------------------"
    echo "Elaborazione JKAN (nuovo): $FILENAME"

    BASE_NOEXT="${FILENAME%.csv}"

    if (
        cd "$TARGET_DIR"
        "$PYTHON" "$SCRIPT_DIR/elabora_JKAN.py" "$FILENAME"
    ); then
        RESULT_XLSX="$TARGET_DIR/${BASE_NOEXT}.xlsx"
        RESULT_HTML="$TARGET_DIR/${BASE_NOEXT}.html"
        echo "Output Excel: $RESULT_XLSX"
        echo "Output HTML: $RESULT_HTML"
        copia_risultato_su_drive "$RESULT_XLSX" "$DRIVE_DIR_MIRO" "MIRO" || true
        copia_risultato_su_drive "$RESULT_HTML" "$DRIVE_DIR_MIRO" "MIRO" || true
        NUOVO_NOME=$(nome_trattato_jkan "$FILENAME")
        echo "Rinomino il file in: $NUOVO_NOME"
        mv "$FILEPATH" "$TARGET_DIR/$NUOVO_NOME"
        processed_jkan=$((processed_jkan + 1))
    else
        echo "Errore durante l'elaborazione JKAN. Il file non è stato rinominato."
    fi
done

echo "--------------------------------------------------"
if [ "$processed_jkan" -eq 0 ]; then
    echo "Nessun nuovo file JKAN elaborato."
else
    echo "Elaborati $processed_jkan nuovo/i file JKAN."
fi
