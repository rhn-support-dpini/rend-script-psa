#!/bin/bash
#
# goAll — copia export PSA da Drive ed elabora solo i file appena copiati.
#
# Lo script risiede in rend-script-psa/; va lanciato da rend-script-psa/venv
# (es. cd rend-script-psa/venv && ../goAll). Dati e risultati in venv/Data/.
# Python viene eseguito dalla cartella script; config cercata anche in venv/.
#
# 1. Esegue copia_drive-PSA.sh (salta file già presenti o già elaborati in venv/Data/)
# 2. Su ogni nuovo DvPFilter-RHCC-All-Assignments-Full* lancia elabora_progetti.py
# 3. Se l'elaborazione va a buon fine, rinomina il file rimuovendo il prefisso DvPFilter-
#
# Variabili opzionali:
#   TARGET_DIR  cartella dati (default: <script>/venv/Data)
#   CLIENTE     filtro cliente per elabora_progetti.py (default: Intesa)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$SCRIPT_DIR/venv"
TARGET_DIR="${TARGET_DIR:-$VENV_DIR/Data}"
CLIENTE="${CLIENTE:-Intesa}"
PATTERN='DvPFilter-RHCC-All-Assignments-Full*'

mkdir -p "$VENV_DIR" "$TARGET_DIR"
TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"

if [ -x "$VENV_DIR/bin/python3" ]; then
    PYTHON="$VENV_DIR/bin/python3"
else
    PYTHON=python3
fi

# Nome senza prefisso DvPFilter- (file già elaborato)
nome_elaborato() {
    local name="$1"
    echo "$name" | sed 's/^DvPFilter-//'
}

# True se esiste già la versione rinominata (post-elaborazione)
file_gia_elaborato() {
    local dvpfilter_name="$1"
    local renamed
    renamed=$(nome_elaborato "$dvpfilter_name")
    [ -e "$TARGET_DIR/$renamed" ]
}

# Elenco file DvPFilter già presenti prima della copia
BEFORE_LIST=""
for f in "$TARGET_DIR"/$PATTERN; do
    [ -e "$f" ] || continue
    BEFORE_LIST+="$(basename "$f")"$'\n'
done

file_gia_presente() {
    local name="$1"
    [ -z "$BEFORE_LIST" ] && return 1
    printf '%s\n' "$BEFORE_LIST" | grep -Fxq "$name"
}

echo "=== 1/2 Copia da Drive (copia_drive-PSA.sh) → $TARGET_DIR ==="
LOCAL_DIR="$TARGET_DIR" "$SCRIPT_DIR/copia_drive-PSA.sh"

if [ ! -d "$TARGET_DIR" ]; then
    echo "Errore: la cartella '$TARGET_DIR' non esiste."
    exit 1
fi

echo ""
echo "=== 2/2 Elaborazione file PSA appena copiati ==="

processed=0
skipped=0

for FILEPATH in "$TARGET_DIR"/$PATTERN; do
    [ -e "$FILEPATH" ] || continue

    FILENAME=$(basename "$FILEPATH")

    if file_gia_presente "$FILENAME"; then
        continue
    fi

    if file_gia_elaborato "$FILENAME"; then
        RENAMED=$(nome_elaborato "$FILENAME")
        echo "Già elaborato (esiste $RENAMED), salto: $FILENAME"
        rm -f "$FILEPATH"
        continue
    fi

    DATA_FILE=$(echo "$FILENAME" | sed -n 's/.*Full-\([0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}\).*/\1/p')
    if [ -z "$DATA_FILE" ]; then
        echo "Salta file (formato data non valido): $FILENAME"
        skipped=$((skipped + 1))
        continue
    fi

    echo "--------------------------------------------------"
    echo "Elaborazione file (nuovo): $FILENAME"
    echo "Data estratta: $DATA_FILE"

    if (
        cd "$SCRIPT_DIR"
        "$PYTHON" elabora_progetti.py "$CLIENTE" "$FILEPATH" "$TARGET_DIR/${DATA_FILE}-Result-PSA.xlsx"
    ); then
        NUOVO_NOME=$(nome_elaborato "$FILENAME")
        echo "Rinomino il file in: $NUOVO_NOME"
        mv "$FILEPATH" "$TARGET_DIR/$NUOVO_NOME"
        processed=$((processed + 1))
    else
        echo "Errore durante l'elaborazione Python. Il file non è stato rinominato."
    fi
done

echo "--------------------------------------------------"
if [ "$processed" -eq 0 ]; then
    echo "Nessun nuovo file PSA elaborato."
else
    echo "Elaborati $processed nuovo/i file."
fi
if [ "$skipped" -gt 0 ]; then
    echo "Saltati $skipped file con nome non valido."
fi
